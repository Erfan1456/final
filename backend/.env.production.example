# Production environment example — EMPTY placeholders only.
# Never commit real secrets. Inject secrets at runtime (container/orchestrator).
#
# APP_ENV=production rejects sandbox email/payment/payout providers even if
# sandbox secrets are present. Configure real providers before serving users.
#
# REQUIRED in production (validated at boot):
APP_ENV=production
MONGODB_URI=
ACCESS_TOKEN_SECRET=
ALLOWED_ORIGINS=
PLATFORM_COMMISSION_BPS=1500

# NOT required for production. Do not rely on these in production.
# SANDBOX_PAYMENT_WEBHOOK_SECRET=
# SANDBOX_PAYOUT_WEBHOOK_SECRET=
